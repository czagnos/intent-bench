# OpenRouter preset: fill this one key to enable both Qwen models.
# Requests to semantic/hybrid methods, catalogue indexing and model checks can incur API usage.
INTENT_DATA_DIR=data/private
INTENT_OPENROUTER_API_KEY=
INTENT_LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional per-service overrides; otherwise the shared OpenRouter key is used.
INTENT_LLM_API_KEY=
INTENT_LLM_MODEL=qwen/qwen3.5-35b-a3b
INTENT_LLM_TIMEOUT_SECONDS=20
INTENT_LLM_RESPONSE_FORMAT=json_schema
# OpenRouter is also detected from its endpoint; on-prem uses chat_template.
INTENT_LLM_THINKING_PARAMETER=openrouter
INTENT_LLM_REASONING=auto
INTENT_LLM_MAX_TOKENS=600
# Optional server-owned preset file; UI changes do not rewrite .env.
# INTENT_MODEL_CATALOG_PATH=/absolute/path/model-presets.json
# Dynamic Model catalog records live in SQLite. Private keys stay in env/file, never the UI.
# In the model form, enter only INTENT_MODEL_KEY_ROUTER_LLM as the key variable name.
# INTENT_MODEL_KEY_ROUTER_LLM=your_private_endpoint_key
# Direct TypeSafe Jev: add this key, then Model catalog > Add TypeSafe Jev.
# Uses the native TypeSafe API independently of OpenRouter.
# INTENT_TYPESAFE_API_KEY=your_typesafe_key
# INTENT_MODEL_CREDENTIALS_FILE=/absolute/path/model.env
INTENT_EMBEDDING_MODE=http
INTENT_EMBEDDING_MODEL=qwen/qwen3-embedding-4b
# auto recognizes Qwen3 Embedding and E5. Use plain for BGE-M3.
INTENT_EMBEDDING_PROFILE=auto
# Optional catalog-neutral query instruction for instruction-aware embedding models.
# INTENT_EMBEDDING_QUERY_INSTRUCTION="Given a user request, retrieve the intent descriptions and examples in the active catalog that match the intended operation or question."
INTENT_EMBEDDING_BATCH_SIZE=32
INTENT_EMBEDDING_TIMEOUT_SECONDS=30
INTENT_EMBEDDING_CPU_THREADS=4
INTENT_EMBEDDING_LOCAL_FILES_ONLY=false
INTENT_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
INTENT_EMBEDDING_API_KEY=
# Optional OpenRouter provider slugs. For a separate 8B/Nebius trial:
# INTENT_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# INTENT_EMBEDDING_PROVIDER_ONLY=["nebius"]
INTENT_EMBEDDING_PROVIDER_ONLY=[]
INTENT_CANDIDATE_K=20
# Optional reranker; only used by strategies that explicitly select one.
# Local mode requires: .venv/bin/pip install '.[ml]'
# INTENT_RERANKER_MODE=local
# INTENT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# INTENT_RERANKER_LOCAL_FILES_ONLY=false
# INTENT_RERANKER_BATCH_SIZE=16
# Or register an HTTP reranker in Model catalog using an environment key reference.
# Server-wide HTTP alternative (the adapter appends /rerank to the base URL):
# INTENT_RERANKER_MODE=http
# INTENT_RERANKER_BASE_URL=http://127.0.0.1:8081
# INTENT_RERANKER_PROTOCOL=tei
# INTENT_RERANKER_API_KEY=
# Exact frontend origins allowed to call the local API, including the development UI.
# Host/Origin checks are browser protections, not user authentication.
INTENT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Accepted API hostnames (ports are checked separately when comparing origins).
# INTENT_TRUSTED_HOSTS=["localhost","127.0.0.1","::1"]

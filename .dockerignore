# Only the application's public build inputs enter the Docker context.
**
!Dockerfile
!LICENSE
!requirements.lock
!apps/api/app/**
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/src/**
!data/demo/**
!data/model-presets.json
!data/retrieval-profiles.json
!data/reranker-comparison-profiles.json
!scripts/*.py

**/__pycache__
**/.env
**/.env.*
**/*.db
**/*.sqlite*
**/*.sql
**/*.dump
**/*.log
**/*.bak
**/*.pem
**/*.key
**/*.p12
**/*.pfx
